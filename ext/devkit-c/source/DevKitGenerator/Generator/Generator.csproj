    </Compile>
    <Compile Update="ResqmlHD5Template.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>ResqmlHD5Template.tt</DependentUpon>
    </Compile>
