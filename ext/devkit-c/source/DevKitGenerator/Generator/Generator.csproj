    </Compile>
    <Compile Include="..\DataAccess\EnumValue\EnumValuesXMLToClass.cs">
      <Link>EnumValue\EnumValuesXMLToClass.cs</Link>
    </Compile>
    <Compile Update="EnergisticsTextTemplate.cs">
